{
	"name": "n8n-nodes-transkriptor",
	"version": "0.1.0",
	"description": "n8n community node for Transkriptor - AI-powered transcription service supporting 100+ languages with speaker recognition, timestamps, and automated summaries.",
	"license": "MIT",
	"homepage": "https://transkriptor.com",
	"keywords": [
		"n8n-community-node-package"
	],
	"author": {
		"name": "Transkriptor",
		"email": "support@transkriptor.com"
	},
	"repository": {
		"type": "git",
		"url": "https://github.com/Linkinor/n8n-nodes-transkriptor.git"
	},
	"scripts": {
		"build": "n8n-node build",
		"build:watch": "tsc --watch",
		"dev": "n8n-node dev",
		"lint": "n8n-node lint",
		"lint:fix": "n8n-node lint --fix",
		"release": "n8n-node release",
		"prepublishOnly": "n8n-node prerelease"
	},
	"files": [
		"dist"
	],
	"n8n": {
		"n8nNodesApiVersion": 1,
		"strict": true,
		"credentials": [
			"dist/credentials/TranskriptorApi.credentials.js"
		],
		"nodes": [
			"dist/nodes/Transkriptor/Transkriptor.node.js"
		]
	},
	"devDependencies": {
		"@n8n/node-cli": "*",
		"eslint": "9.39.4",
		"prettier": "3.8.3",
		"release-it": "20.2.0",
		"typescript": "6.0.3"
	},
	"peerDependencies": {
		"n8n-workflow": "*"
	}
}
